---
import Layout from '../layouts/Layout.astro';
import Arrow from './Arrow.astro';
import Recordings from './Recordings.astro';
import Album from './Album.astro';
import Contact from './Contact.astro';
import {site,pathTo,photo,homeFor,mailTo,type Language} from '../lib/site';
interface Props {lang?:Language}
const {lang='de'}=Astro.props;
const ko=lang==='ko';
const audiences=ko ? [
  {title:'어린이 & 청소년',text:'호기심을 음악으로. 어린이의 관심과 수준에 맞춰 피아노를 알아갑니다.',tag:'호기심에서 첫 멜로디까지'},
  {title:'성인 & 취미',text:'음악을 시작하기에 늦은 때는 없습니다. 초보자부터 다시 피아노를 시작하고 싶은 분까지 환영합니다.',tag:'나의 속도로'},
  {title:'전공 & 음대 입시',text:'독일 음대 입시 준비, 실내악 및 반주. 각자의 목표에 맞는 개인 레슨을 진행합니다.',tag:'더 깊은 음악으로'}
] : [
  {title:'Kinder & Jugendliche',text:'Mit Neugier ans Klavier. Ich gehe auf die Interessen und das individuelle Können jedes Kindes ein.',tag:'Ausprobieren. Entdecken. Spielen.'},
  {title:'Erwachsene & Wiedereinsteiger',text:'Ein neuer Anfang oder eine alte Liebe. Auch ohne Vorkenntnisse und in jedem Alter bist du willkommen.',tag:'In deinem eigenen Tempo.'},
  {title:'Fortgeschrittene & Studium',text:'Musikalisch weiterkommen: mit professioneller Vorbereitung auf das Musikstudium, Kammermusik und Korrepetition.',tag:'Raum für deine nächsten Schritte.'}
];
const faqs=ko ? [
  ['피아노를 처음 배워도 되나요?','네. 처음 피아노를 배우는 분부터 경험이 있는 분까지 환영합니다. 각자의 관심과 수준에 맞춰 레슨을 진행합니다.'],
  ['어떤 언어로 레슨하나요?','독일어와 한국어로 레슨할 수 있습니다. 문의할 때 편한 언어를 알려주세요.'],
  ['독일 음대 입시도 준비할 수 있나요?','네. 개인별 입시 준비 레슨과 상담을 제공합니다. 레슨 방식과 비용은 개인의 상황에 따라 상담 후 결정합니다.'],
  ['레슨비는 얼마인가요?','개별 레슨은 30분 45 €, 45분 50 €, 60분 60 €입니다. 첫 레슨은 30 €이며, 음대 입시 준비와 반주는 별도 상담합니다.'],
  ['어디에서 레슨하나요?','베를린 프렌츠라우어베르크에서 레슨합니다. 구체적인 장소와 가능한 시간은 이메일로 문의해 주세요.']
] : [
  ['Kann ich ohne Vorkenntnisse anfangen?','Ja. Sowohl Anfänger als auch Fortgeschrittene sind herzlich willkommen. Wir orientieren uns an deinen Wünschen und deinem aktuellen Stand.'],
  ['Bin ich als Erwachsener zu alt, um Klavier zu lernen?','Nein. Ich unterrichte Erwachsene, Senioren, Studenten und Kinder. Es gibt kein zu alt – entscheidend sind dein Interesse und die Freude an der Musik.'],
  ['Welche Musik kann ich im Unterricht spielen?','Von Klassik bis Pop: Mozart ist ebenso möglich wie ein Song von Adele. Ich gehe gerne auf individuelle musikalische Wünsche ein.'],
  ['Wie viel kostet eine Probestunde?','Eine Probestunde kostet 30 €. Reguläre Einzelstunden kosten 45 € für 30 Minuten, 50 € für 45 Minuten und 60 € für 60 Minuten. Studienvorbereitung und Korrepetition nach Absprache.'],
  ['Wo findet der Klavierunterricht statt?','Der Unterricht findet in Berlin Prenzlauer Berg statt. Fragen zum genauen Unterrichtsort und zu freien Terminen klären wir per E-Mail.'],
  ['Bietest du Vorbereitung auf das Musikstudium an?','Ja. Ich biete professionelle Studienvorbereitung für angehende Bachelor- und Masterstudierende an. Umfang und Preis besprechen wir individuell.'],
  ['Kann ich eine vereinbarte Stunde absagen?','Vereinbarte Stunden können bis spätestens einen Tag vorher abgesagt werden. Am gleichen Tag abgesagte Stunden werden bezahlt. Für eine 10er-Karte finden die zehn Stunden innerhalb von zwölf Wochen statt; die zusätzliche Gratisstunde kann danach eingelöst werden.']
];
---
<Layout lang={lang} home canonicalPath={homeFor(lang)}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-inner container">
      <div class="hero-portrait">
        <img src={photo('header1-1.jpg')} srcset={`${photo('header1-1-768x412.jpg')} 768w, ${photo('header1-1-1024x549.jpg')} 1024w, ${photo('header1-1.jpg')} 1658w`} sizes="(max-width: 960px) calc(100vw - 40px), 920px" width="1658" height="889" fetchpriority="high" loading="eager" alt={ko?'두 손을 펼친 피아니스트 김종숙':'Pianistin und Klavierlehrerin Jongsuk Kim zeigt ihre Hände'} />
      </div>
      <div class="hero-copy">
        <div>
          <h1 id="hero-title">{ko ? <>베를린 피아노 레슨</> : <>Klavierunterricht in Berlin<br/><span class="hero-location"> Prenzlauer Berg</span></>}</h1>
          <p class="hero-description">{ko?'첫 음부터 나만의 음악까지. 피아니스트 김종숙과 함께하는 개인 레슨과 독일 음대 입시 준비.':'Vom ersten Ton bis zu deinem Lieblingsstück. Individueller Klavierunterricht mit Pianistin Jongsuk Kim – für Kinder, Erwachsene und alle, die Musik lieben.'}</p>
        </div>
        <div class="hero-invite">
          <a class="button button-dark" href="#kontakt">{ko?'상담 문의하기':'Probestunde anfragen'}<Arrow diagonal /></a>
          <span class="hero-note">{ko?'취미 · 전공 · 독일 음대 입시':'Anfänger & Fortgeschrittene · 30 €'}</span>
        </div>
      </div>
    </div>
  </section>
  <div class="intro-strip"><div class="container"><span>{ko?'어린이부터 성인까지':'Für jedes Alter'}</span><span>{ko?'초보부터 전공자까지':'Für jedes Level'}</span><span>{ko?'독일어 & 한국어':'Deutsch & Koreanisch'}</span><span>{ko?'나만의 음악으로':'Deine Musik im Mittelpunkt'}</span></div></div>
  <section class="lesson-section section-space container" id="unterricht">
    <div class="section-heading"><p class="eyebrow">01 / {ko?'피아노 레슨':'Klavierunterricht'}</p><h2>{ko?'나의 속도로,':'Dein Tempo.'}<br/><em>{ko?'나만의 음악으로.':'Deine Musik.'}</em></h2></div>
    <div class="lesson-intro"><p class="lead">{ko?'음악을 시작하기에 늦은 때는 없습니다.':'Es gibt kein zu alt. Und (fast) kein zu jung.'}</p><p>{ko?'음대입시를 위한 개인 레슨 뿐 아니라 취미로 피아노를 배우고 싶으신 분, 실내악 파트너를 찾으시는 분이나, 반주가 필요하신 분들도 환영합니다! 늦었다고 생각하는 순간 시작하시면 됩니다.':'Ich unterrichte Erwachsene, Kinder, Senioren, Studenten und alle anderen, die sich zu keiner dieser Gruppen zählen wollen. Ob du ganz neu anfängst oder nach einer Pause wieder einsteigst: Du bist herzlich willkommen.'}</p><p>{ko?'각자의 관심과 목표에 맞춰 함께 음악을 만들어 갑니다.':'Ich versuche zunächst herauszufinden, was jeder einzelne Schüler gerne lernen möchte. Dabei ist vieles möglich, ob Mozart oder einfach ein Song von Adele. Ich gehe gerne auf individuelle Wünsche ein.'}</p></div>
    <div class="audience-grid">{audiences.map((item,index)=><article class="audience"><span class="audience-number">0{index+1}</span><h3>{item.title}</h3><p>{item.text}</p><span class="audience-tag">{item.tag}</span></article>)}</div>
    <div class="lesson-moments"><div class="moment-images"><img src={photo('kind2.jpg')} width="383" height="383" loading="lazy" alt={ko?'피아노를 치는 어린이':'Ein Kind entdeckt das Klavierspiel'} /><img src={photo('kind1.jpg')} width="383" height="383" loading="lazy" alt={ko?'피아노 레슨을 받는 어린이':'Ein Kind spielt Klavier im Unterricht'} /></div><blockquote><p>{ko?'음악에서 가장 중요한 것은 즐거움입니다.':'„Wichtig ist vor allem, dass es Spaß macht. Denn dazu ist die Musik schließlich da.“'}</p><cite>Jongsuk Kim</cite></blockquote></div>
    {ko && <div class="korean-study prose"><h3>독일 음대 입시 준비</h3><p>독일 음대 입학을 꿈꾸는 수험생들에게 음대 합격의 길을 열어드립니다. 많은 경험을 바탕으로 입시에 적합한 맞춤식 지도를 하고 있으며 지역별 학교 특징을 반영한 입학 관련 안내, 입시 지원서 작성, 음대교수와의 콘탁 및 레슨, 독일어 통역 및 독일인과의 1:1 독일어 과외 연결에도 도움을 주고 있습니다.</p><p>상담은 보통 1시간 정도 진행되며 각자의 상황에 맞는 앞으로의 입시전략에 대하여 대화를 하게 됩니다. 취미반 / 입시반 유형에 따라 레슨 하는 방식과 레슨비에 차이가 있습니다. 부담 없이 상담 신청하세요.</p></div>}
  </section>
  <section class="about-section" id="aboutme">
    <div class="container about-grid">
      <div class="about-heading"><p class="eyebrow">02 / {ko?'피아니스트 소개':'Über mich'}</p><h2>{ko?'안녕하세요,':'Hallo,'}<br/><em>{ko?'김종숙입니다.':'ich bin Jongsuk.'}</em></h2><p class="about-signature">Jongsuk Kim <span lang="ko">김종숙</span></p></div>
      <div class="about-copy">
        {ko ? <><p class="lead">피아니스트 · 피아노 선생님 · 베를린</p><p>고전과 현대를 아우르는 폭넓은 음악적 영역에서 섬세한 터치와 깊이 있는 연주로 주목 받고 있는 피아니스트 김종숙은 Freiburg Musikhochschule에서 석사과정(Künstlerische Ausbildung)을 졸업하였으며, Detmold Musikhochschule에서 최고연주자과정(Konzertexamen)을, 그 후 동대학에서 실내악(Kammermusik)과정을 심사위원 만장일치로 졸업하며 솔로 피아니트스로서 뿐 아니라 앙상블 연주자로서의 기반을 단단히 하였다. (사사: Prof. Gilead Mishory, Prof. Matitjahu Kellig, Prof. Peter Orth)</p></> : <><p class="lead">Pianistin, Klavierlehrerin – und am liebsten mittendrin in der Musik.</p><p>Ich lebe und arbeite als Pianistin und Klavierlehrerin in Berlin Prenzlauer Berg. Geboren und aufgewachsen bin ich in Seoul, Korea. Heute unterrichte ich auf Deutsch und Koreanisch.</p><p>Schon früh habe ich eine Liebe zum Klavier und zur Musik entwickelt. Deshalb bin ich zunächst auf eine musikfördernde Schule und schließlich zum Studium der Musik an die Musikhochschule gegangen. Meine Begeisterung für die klassische Musik führte mich zum Studium nach Deutschland.</p><p>Nach meiner Ausbildung in Freiburg und Detmold lebe ich heute in Berlin und arbeite hier als Lehrerin, Begleiterin und Solopianistin.</p></>}
        <a class="text-link" href={pathTo('/bio/')}>{ko?'전체 프로필 (독일어)':'Mehr über meinen musikalischen Weg'}<Arrow /></a>
      </div>
    </div>
  </section>
  <section class="prices-section section-space container" id="preise">
    <div class="prices-intro"><p class="eyebrow">03 / {ko?'레슨비':'Preise & Probestunde'}</p><h2>{ko?'음악을 위한':'Zeit für'}<br/><em>{ko?'나만의 시간.':'deine Musik.'}</em></h2><p>{ko?'개별 레슨 또는 10회권. 나에게 맞는 시간으로 시작해 보세요.':'Einzelstunden oder eine 10er-Karte: Du wählst die Unterrichtsdauer, die zu dir passt.'}</p><a class="text-link" href={pathTo('/downloads/preise-klavierschule.pdf')}>{ko?'레슨비 안내 (PDF)':'Preisliste als PDF'}<Arrow diagonal /></a><span class="price-date">{ko?'기준일':'Stand'}: {site.pricesUpdated}</span></div>
    <div class="price-options"><div class="trial-row"><div><span class="eyebrow">{ko?'함께 시작해요':'Zum Kennenlernen'}</span><h3>{ko?'첫 레슨':'Deine Probestunde'}</h3></div><span class="trial-price">30<span> €</span></span><a href="#kontakt" aria-label={ko?'첫 레슨 문의':'Probestunde für 30 Euro anfragen'}><Arrow diagonal /></a></div>
      <div class="price-table"><span class="eyebrow">{ko?'개별 레슨':'Einzelunterricht'}</span>{site.prices.map(({minutes,price})=><div class="price-row"><span><strong>{minutes}</strong> {ko?'분':'Minuten'}</span><span>{price} €</span></div>)}</div>
      <div class="ten-card"><span class="ten-card-number">10<span>+1</span></span><div><h3>{ko?'10회권':'Die 10er-Karte'}</h3><p>{ko?'10회권 구매 시 1회 레슨을 추가로 드립니다. 선물용으로도 좋습니다.':'Zehn Stunden kaufen, eine zusätzliche Stunde geschenkt bekommen. Auch als Gutschein eine schöne Idee.'}</p><small>{ko?'10회 레슨은 12주 내 진행됩니다. 추가 1회는 이후 사용 가능합니다.':'Die zehn Stunden finden innerhalb von zwölf Wochen statt. Die Gratisstunde kann danach eingelöst werden.'}</small></div></div>
      <div class="price-extra">
        <p><strong>{ko?'독일 음대 입시 준비':'Studienvorbereitung für Bachelor / Master'}</strong><br />{ko?'레슨비는 개별 상담 후 결정합니다.':'Preis nach Absprache.'}</p>
        <p><strong>{ko?'반주':'Korrepetition'}</strong><br />{ko?'비용은 개별 상담 후 결정합니다.':'Preis nach Absprache.'}</p>
      </div>
    </div>
  </section>
  <section class="music-section section-space" id="pianistin">
    <div class="container">
      <div class="music-header"><div><p class="eyebrow">04 / {ko?'연주':'Als Pianistin'}</p><h2>{ko?'말이 끝나는 곳에,':'Wo Worte aufhören,'}<br/><em>{ko?'음악이 시작됩니다.':'beginnt die Musik.'}</em></h2></div><a class="text-link" href={pathTo('/downloads/jongsukkim_repertoire.pdf')}>{ko?'레퍼토리 (PDF)':'Mein Repertoire (PDF)'}<Arrow diagonal /></a></div>
      <div class="music-story"><figure id="pianistinbild"><img src={photo('pianistin_foto.jpg')} width="962" height="604" alt={ko?'무대에서 피아노를 연주하는 김종숙':'Jongsuk Kim als Konzertpianistin am Flügel'} loading="lazy" /><figcaption>{ko?'솔로 · 실내악 · 반주':'Solo · Kammermusik · Korrepetition'}</figcaption></figure><div id="pianistin_content">{ko ? <p>남다른 소신과 열정을 가지고 진정성을 전달하는 피아니스트 김종숙은 프라이부르크, 데트몰트 등에서 공부를 마치고, 2015년부터 솔로 피아니스트로서, 실내악 파트너로서, 반주자로서 좋은 무대를 보여주고 있다. 그녀는 음악적 지성과 성숙미를 갖추기 위해 꾸준히 연구하며, 다양한 레퍼토리를 통해 청중들과 교감할 수 있는 연주가를 목표로, 음악에 관련한 꾸준한 열정과 사랑으로 후배를 양성하는 데 있어서 함께 발전하기를 꿈꾼다.</p> : <><p class="lead">Die Begeisterung, die ich auf der Bühne spüre, gebe ich im Unterricht weiter.</p><p>Jongsuk Kim ist als Kammermusikpartnerin, Solistin als auch als Korrepetitorin eine gefragte Künstlerin. Ihre feinfühlige Musikalität und ihre frische, lebendige Spielweise werden sowohl von Mitspielern als auch vom Publikum begeistert aufgenommen.</p><p>Sie ist Preisträgerin internationaler Wettbewerbe und kann auf eine langjährige Karriere als Klaviersolistin zurückblicken.</p></>}
      </div></div>
      <Album lang={lang} />
      <div class="recordings-heading"><span class="eyebrow">{ko?'연주 감상':'Einfach mal reinhören'}</span><span>{ko?'피아노: 김종숙':'Am Klavier: Jongsuk Kim'}</span></div><Recordings lang={lang} />
    </div>
  </section>
  <section class="faq-section section-space container" id="fragen"><div class="section-heading"><p class="eyebrow">{ko?'자주 묻는 질문':'Noch eine Frage?'}</p><h2>{ko?'시작하기':'Gut zu'}<br/><em>{ko?'전에.':'wissen.'}</em></h2><p>{ko?'더 궁금한 점이 있으신가요?':'Deine Frage ist nicht dabei?'}<br/><a href={mailTo(ko?'피아노 레슨 문의':'Frage zum Klavierunterricht')}>{ko?'이메일로 문의해 주세요.':'Schreib mir gerne.'}</a></p></div><div class="faq-list">{faqs.map(([question,answer])=><details class="faq"><summary>{question}<span aria-hidden="true">+</span></summary><div><p>{answer}</p></div></details>)}</div>
  </section>
  <Contact lang={lang} />
</Layout>
